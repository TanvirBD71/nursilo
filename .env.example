# Nursilo — copy to .env and fill locally. Never commit real secrets.
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL (required for migrate/tests; copy to .env and set a real password)
DB_NAME=nursilo_dev
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Development demo seed only (seed_demo_data / cleanup_demo_data). Never commit real secrets.
# If unset, a local-only fallback is used — value is never printed by the command.
# NURSILO_DEMO_PASSWORD=

# Email (console locally when EMAIL_HOST is empty; SMTP when set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Static / media
# STATIC_ROOT: collectstatic output (default: <project>/staticfiles) — not source static/
# MEDIA_ROOT: private storage for mediated library keys — do not public-Alias protected books
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=
MEDIA_ROOT=

# Production-only (config-ready; Cloudflare SSL/HSTS decision pending — leave off until confirmed)
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0

# UNIT-8 — Annual Premium plan (authoritative config; not hard-coded in workflows)
NURSILO_PLAN_ANNUAL_PREMIUM_CODE=annual_premium
NURSILO_PLAN_ANNUAL_PREMIUM_NAME=Annual Premium
NURSILO_PLAN_ANNUAL_PREMIUM_AMOUNT=199
NURSILO_PLAN_ANNUAL_PREMIUM_DURATION_DAYS=365

# UNIT-8 — SSLCommerz sandbox only (leave blank until sandbox credentials exist)
# Never commit real store_id / store_passwd. Live gateway is not enabled in V1.
NURSILO_PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
